# ---------------------------------------------------------------
# Copy to `.env.local` for local development. Never commit real keys.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------

# Canonical public URL of the site (used for metadata, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (server-side only; required for email delivery) -----------
# Resend API key (https://resend.com). Stays on the server — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Address that receives contact form messages.
CONTACT_TO_EMAIL=aniketbarai677@gmail.com
# Verified sender on your Resend domain, e.g. "Portfolio <contact@yourdomain.dev>".
CONTACT_FROM_EMAIL=

# --- Spam protection (optional but recommended) ------------------------------
# Cloudflare Turnstile. If the secret is set the server verifies every submission.
TURNSTILE_SECRET_KEY=
# Public site key shown in the browser widget. Required together with the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
